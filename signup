<!-- Web Technology / Project phase 1 -->
<!-- Online Library Website -->
<!-- Sign-up file -->

<!DOCTYPE HTML>

<html>
    <head>
        <title> Sign-up </title>
    </head>

    <body>
        <form>
            <div>
                <label for="username"> Username: </label>
                <input type="text" id="username" name="username" placeholder="username" maxlength="10" required>
            </div>

            <br>

            <div>
                <label for="password"> Password: </label>
                <input type="password" id="password" name="password" placeholder="password" maxlength="10" required>
            </div>

            <br>
            
            <div>
                <label for="confirmPassword"> Confirm Password: </label>
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="confirm password" maxlength="10" required>
            </div>

        
            <br>
            
            <div>
                <label for="email"> Email: </label>
                <input type="email" id="email" name="email" placeholder="example@gmail.com" required>
            </div>

            <br>
            
            <div>
            <label for="is_admin"> Admin/User: </label>

            <br>

            <label for="admin"> Admin </label>
            <input type="radio" id="admin" name="is_admin" value="Admin" required>
            
            <label for="user"> User </label>
            <input type="radio" id="user" name="is_admin" value="User">
            </div>

            <br> 

            <button type="reset"> Reset </button>
            <button type="submit"> Signup </button>
        </form>
    </body>
</html>
