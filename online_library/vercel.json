{
  "version": 2,
  "builds": [
    {
      "src": "online_library/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "online_library/wsgi.py"
    }
  ],
  "build": {
    "env": {
      "PYTHONPATH": "online_library",
      "DJANGO_SETTINGS_MODULE": "online_library.settings"
    }
  }
}