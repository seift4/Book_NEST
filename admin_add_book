<!-- Web Technology / Project phase 1 -->
<!-- Online Library Website -->
<!-- Admin: Add book (file) -->

<!DOCTYPE html>
<html>
    <head>
        <title> Add book (Admin) </title>
    </head>

    <body>
        <h1> Add book </h1>

        <form>
            <div>
            <label for="bookID">ID: </label>
            <input type="text" id="bookID" name="bookID" placeholder="ID" required>
            </div>

            <br>

            <div>
            <label for="bookName">Name: </label>
            <input type="text" id="bookName" name="bookName" placeholder="name" required>
            </div>
            
            <br>

            <div>
            <label for="bookAuthor">Author: </label>
            <input type="text" id="bookAuthor" name="bookAuthor" placeholder="author" required>
            </div>

            <br>

            <div>
                <label for="category"> Category: </label>
                <select id="category" name="bookCategory" required>
                    <option value="" disabled selected> Select a category: </option>
                    <option value="fiction">Fiction</option>
                    <option value="non-fiction">Non-Fiction</option>
                    <option value="science">Science</option>
                    <option value="history">History</option>
                    <option value="technology">Technology</option>
                    <option value="business">Business</option>
                    <option value="self-help">Self-Help</option>
                    <option value="children">Children</option>
                </select>
            </div>

            <br> 
            
            <div>
                <label for="bookDescription">Description: </label>
                <br>
                <textarea id="bookDescription" name="bookDescription" rows="5" cols="35" placeholder="Write the book description here..."></textarea>
            </div>

            <br> 
            
            <div>
                <button type="reset">Reset</button>
                <button type="submit">Add</button>
            </div>
        </form>
    </body>


</html>
